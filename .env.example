# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL Connection String
# Example: postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Worldpay Access Platform Configuration (dashboard.worldpay.com)
WORLDPAY_ENVIRONMENT=live
WORLDPAY_ENTITY=
WORLDPAY_ENTITY_ID=
WORLDPAY_CHECKOUT_ID=
NEXT_PUBLIC_WORLDPAY_CHECKOUT_ID=
WORLDPAY_API_USERNAME=
WORLDPAY_API_PASSWORD=
WORLDPAY_API_KEY=
WORLDPAY_BASE_URL=https://access.worldpay.com
NEXT_PUBLIC_WORLDPAY_BASE_URL=https://access.worldpay.com
# WORLDPAY_WEBHOOK_SECRET= (Optional - only required if signed webhooks are enabled in Worldpay)

# Development only. When true, a recurring (merchant-initiated) subscription
# charge that has no usable Worldpay stored credential — or that Worldpay
# rejects — returns a SIMULATED authorization instead of failing. The renewal
# order is then recorded as Paid even though no money moved, so this must stay
# unset/false in production. Use it to exercise the 1-day test schedule locally.
WORLDPAY_ALLOW_SIMULATED_MIT=false

# How the shopper consents to their card being stored on the Hosted Payment
# Page: Silent (consent taken in our own checkout terms, no second prompt) or
# ASK (Worldpay asks on its page). Silent has to be enabled on the Worldpay
# account — if Worldpay rejects the payment page request, switch to ASK rather
# than losing the token, because a checkout with no token cannot renew.
WORLDPAY_TOKEN_OPT_IN=Silent

# Auto-settlement on recurring charges. Leave unset: the charge tries the
# `settlement` object Worldpay support supplied, falls back to the v6
# `requestAutoSettlement` spelling if the account's schema rejects it, and logs
# which one was accepted. Pin it here once you know — settlement |
# requestAutoSettlement | none.
# WORLDPAY_SETTLEMENT_SHAPE=auto

# Set to false to authorise renewals without asking for settlement at all. Only
# do this if the Worldpay account settles automatically on its own; otherwise
# the money is reserved and released rather than collected.
WORLDPAY_AUTO_SETTLE=true

# Email Configuration (Gmail / SMTP / Resend)
EMAIL_PROVIDER=gmail
GMAIL_USER=scottkivlinpouch@gmail.com
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@pouch-supply.com
ADMIN_NOTIFICATION_EMAIL=admin@pouch-supply.com

# Klaviyo Marketing Automation Configuration
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
KLAVIYO_API_KEY=
KLAVIYO_SITE_ID=

# Royal Mail Click & Drop API Configuration (LIVE ONLY - there is no test mode).
# Generate an API Authorization key in Click & Drop:
#   Settings > Integrations > Click & Drop API
# Without a valid key every shipment, label and tracking call fails loudly;
# nothing is simulated.
RM_API_KEY=
RM_API_BASE_URL=https://api.parcel.royalmail.com/api/v1
ROYAL_MAIL_API_KEY=
# When true, a shipment is registered the moment a payment succeeds, which marks
# the order Shipped and sends the dispatch email alongside the order
# confirmation. Leave false so orders are dispatched when they are actually
# packed (from the admin Orders tab or the Royal Mail routes).
ROYAL_MAIL_AUTO_DISPATCH=false

# AgeChecked AC0130 Integration Configuration
AGECHECKED_SECRET_KEY=
AGECHECKED_BASE_URL=https://staging.agechecked.com/api/acapiremote/ac0130
NEXT_PUBLIC_AGECHECKED_PORTAL_URL=https://portal.agechecked.com/portal
NEXT_PUBLIC_AGECHECKED_PUBLIC_KEY=

# Auth.js / Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=

# ---------------------------------------------------------------------------
# Admin authentication — REQUIRED
#
# Without these the admin dashboard cannot sign anyone in (503) and every admin
# endpoint refuses every request. That is deliberate: a default secret would be
# a publicly known secret, so the code fails closed rather than open.
#
# AUTH_SECRET signs admin session tokens. At least 16 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every issued token, which is how you force a re-login.
AUTH_SECRET=

# The single administrator account. ADMIN_PASSWORD is the dashboard password —
# treat it like any other production credential and never commit a real value.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Authenticates the scheduled jobs in vercel.json (subscription renewals,
# Worldpay reconciliation, Royal Mail sync). Vercel sends this automatically as
# a bearer token when it is set in the project's environment variables. Without
# it those endpoints refuse to run rather than staying open to the internet.
CRON_SECRET=





